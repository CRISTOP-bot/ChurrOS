#!/usr/bin/env bash
#
# churros-pick-image — Selector de imagen.
# Soporta Wayland y X11.
#
#   1. Zenity (standalone, GTK file picker)
#   2. yad (alternativa)
#   3. Gtk.FileDialog via python (fallback puro GTK4)
#

INIT_DIR="${1:-$HOME}"
INIT_DIR="${INIT_DIR/#\~/$HOME}"

log() { printf '[churros-pick-image] %s\n' "$*" >&2; }

export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"

pick_via_zenity() {

    if ! command -v zenity >/dev/null 2>&1; then
        return 1
    fi

    zenity --file-selection \
        --title="Importar imagen de fondo" \
        --filename="$INIT_DIR/" \
        --file-filter='Imagenes | *.jpg *.jpeg *.png *.webp *.gif' \
        --file-filter='Todos los archivos | *' \
        2>/dev/null

    return $?
}

pick_via_yad() {

    if ! command -v yad >/dev/null 2>&1; then
        return 1
    fi

    yad --file \
        --title="Importar imagen de fondo" \
        --filename="$INIT_DIR/" \
        --file-filter='Image files | *.jpg *.jpeg *.png *.webp *.gif' \
        2>/dev/null

    return $?
}

pick_via_python() {

    python3 -c "
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, GLib, Gio
import sys, os

def on_result(dialog, result):
    try:
        file = dialog.open_finish(result)
        if file:
            path = file.get_path()
            if path and os.path.isfile(path):
                print(path)
    except GLib.Error:
        pass
    except Exception:
        pass
    Gtk.main_quit()

dialog = Gtk.FileDialog()
dialog.set_title('Importar imagen de fondo')
flt = Gtk.FileFilter()
flt.set_name('Imagenes')
for mt in ['image/jpeg', 'image/png', 'image/webp', 'image/gif']:
    flt.add_mime_type(mt)
filters = Gio.ListStore.new(Gtk.FileFilter)
filters.append(flt)
dialog.set_filters(filters)
dialog.set_default_filter(flt)
dialog.set_initial_folder(Gio.File.new_for_path('$INIT_DIR'))
dialog.open(None, None, on_result)
Gtk.main()
"
}

result=$(pick_via_zenity 2>/dev/null) || result=""

if [ -n "$result" ] && [ -f "$result" ]; then
    echo "$result"
    exit 0
fi

log "zenity fallo o cancelo, intentando yad..."

result=$(pick_via_yad 2>/dev/null) || result=""

if [ -n "$result" ] && [ -f "$result" ]; then
    echo "$result"
    exit 0
fi

log "yad no disponible, intentando python GTK4..."

result=$(pick_via_python 2>/dev/null) || result=""

if [ -n "$result" ] && [ -f "$result" ]; then
    echo "$result"
    exit 0
fi

log "ningun selector disponible"
exit 1