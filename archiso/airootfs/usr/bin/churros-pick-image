#!/usr/bin/env bash
#
# churros-pick-image — Selector de imagen.
#
#   1. Zenity (standalone, GTK file picker, no necesita portal)
#   2. yad (alternativa)
#   3. thunar visual + zenity entry (último recurso, manual)
#
# Uso: churros-pick-image [directorio_inicial]
#   imprime la ruta seleccionada a stdout.
#

INIT_DIR="${1:-$HOME}"
INIT_DIR="${INIT_DIR/#\~/$HOME}"

log() { printf '[churros-pick-image] %s\n' "$*" >&2; }

pick_via_zenity() {

    if ! command -v zenity >/dev/null 2>&1; then
        return 1
    fi

    zenity --file-selection \
        --title="Importar imagen de fondo" \
        --filename="$INIT_DIR/" \
        --file-filter='Imagenes | *.jpg *.jpeg *.png *.webp *.gif' \
        --file-filter='Todos los archivos | *' \
        2>/dev/null

    return $?
}

pick_via_yad() {

    if ! command -v yad >/dev/null 2>&1; then
        return 1
    fi

    yad --file \
        --title="Importar imagen de fondo" \
        --filename="$INIT_DIR/" \
        --file-filter='Image files | *.jpg *.jpeg *.png *.webp *.gif' \
        2>/dev/null

    return $?
}

pick_via_thunar() {

    if ! command -v thunar >/dev/null 2>&1; then
        return 1
    fi

    if command -v notify-send >/dev/null 2>&1; then

        notify-send "ChurOS" \
            "Thunar esta abierto. Cuando elijas la imagen, escribe su ruta completa." \
            2>/dev/null || true

    fi

    thunar "$INIT_DIR" >/dev/null 2>&1 &

    local input=""
    local attempt=0

    while [ "$attempt" -lt 3 ]; do

        if command -v zenity >/dev/null 2>&1; then

            input=$(zenity --entry \
                --title="Ruta de la imagen" \
                --text="Thunar esta abierto.\nEscribe la ruta completa de la imagen que elegiste:" \
                --entry-text="/home/" 2>/dev/null) || input=""

        fi

        if [ -n "$input" ] && [ -f "$input" ]; then

            pkill -x thunar 2>/dev/null || true
            echo "$input"
            return 0

        fi

        attempt=$((attempt + 1))

    done

    pkill -x thunar 2>/dev/null || true

    return 1
}

# ── Cadena principal ────────────────────────────────────

result=$(pick_via_zenity 2>/dev/null) || result=""

if [ -n "$result" ] && [ -f "$result" ]; then
    echo "$result"
    exit 0
fi

log "zenity fallo o cancelo, intentando yad..."

result=$(pick_via_yad 2>/dev/null) || result=""

if [ -n "$result" ] && [ -f "$result" ]; then
    echo "$result"
    exit 0
fi

log "yad no disponible, intentando thunar..."

pick_via_thunar
exit $?
