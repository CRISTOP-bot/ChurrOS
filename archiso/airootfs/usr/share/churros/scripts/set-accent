#!/usr/bin/env bash
#
# set-accent — Regenera ~/.config/churros/accent.css desde CLI
#
# Usage:
#   set-accent              # usa el color guardado en settings.json
#   set-accent Orange       # fuerza un color específico
#

set -e

COLOR="${1:-}"

PYTHON="${PYTHON:-python3}"

if [ -n "$COLOR" ]; then
    exec "$PYTHON" -c "
import sys
sys.path.insert(0, '/usr/share/churros/preferences')
from services.accent import AccentService
AccentService.set('$COLOR')
print(f'Accent set to: $COLOR')
"
else
    exec "$PYTHON" -c "
import sys
sys.path.insert(0, '/usr/share/churros/preferences')
from services.accent import AccentService
AccentService.ensure()
print(f'Accent regenerated: {AccentService.current()}')
"
fi
